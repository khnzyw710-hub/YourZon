# Zon — API Keys Template
# Copy this file to .env.local and fill in your keys.
# Keys are stored at runtime in iOS Keychain / Android Keystore via expo-secure-store.
# These env vars are only referenced during local development — never commit real keys.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GROK_API_KEY=xai-...
ELEVENLABS_API_KEY=...
PICOVOICE_ACCESS_KEY=...
